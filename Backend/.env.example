# ============================================================================
#  TechFix - Variables de entorno del Backend
#  Copia este archivo como  .env  (sin el .example) y rellena los valores.
#  El archivo .env NO se sube a git (está en .gitignore).
# ============================================================================

# --- Base de datos: Supabase (PostgreSQL) ---
# La consigues en Supabase:  Project Settings -> Database -> Connection string.
# Recomendado: la pestaña "Connection pooler" (modo Transaction, puerto 6543).
# Reemplaza <REF>, <REGION> y [TU-PASSWORD] por los valores de tu proyecto.
DATABASE_URL=postgresql://postgres.<REF>:[TU-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Seguridad: clave para firmar los tokens JWT ---
# Pon una cadena larga y aleatoria; NO la compartas ni la subas a git.
# Puedes generar una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=pon-aqui-una-clave-larga-y-secreta

# Minutos que dura la sesión antes de expirar
JWT_EXPIRATION_MINUTES=30
